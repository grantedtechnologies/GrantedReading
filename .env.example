# Azure LLM (DeepSeek agent via AI Foundry)
LLM_ENDPOINT=
LLM_AGENT_NAME=your-agent-name

# Flux image generation
FLUX_API_KEY=your-flux-api-key
FLUX_API_URL=
FLUX_MODEL=FLUX.2-pro

# MySQL. db.py builds mysql+pymysql:// from these, or use DATABASE_URL instead.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=granteddb
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/granteddb

# Redis (standard-plan daily worksheet limit)
REDIS_URL=redis://localhost:6379/0

# Flask server (optional)
PORT=5000
FLASK_DEBUG=true
SECRET_KEY=change-me
