# Azure LLM (DeepSeek agent via AI Foundry)
LLM_ENDPOINT=https://your-project.cognitiveservices.azure.com/
LLM_AGENT_NAME=your-agent-name

# Azure Service Principal Authentication
# Required for Railway and other non-Azure deployments
# Create in Azure Portal: App registrations → New registration
# Then: Certificates & secrets → New client secret
AZURE_CLIENT_ID=your-app-registration-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# Flux image generation
FLUX_API_KEY=your-flux-api-key
FLUX_API_URL=https://api.bfl.ml
FLUX_MODEL=FLUX.2-pro

# MySQL. The app picks a set from where it is running. Railway sets
# RAILWAY_ENVIRONMENT, so the deployed service uses RAILWAY_DATABASE_*.
# Your laptop uses LOCAL_DATABASE_*. MYSQL_USER and MYSQL_PORT are shared.
# mysql.railway.internal only resolves inside Railway.
LOCAL_DATABASE_HOST=localhost
LOCAL_DATABASE_NAME=granteddb
LOCAL_DATABASE_PASSWORD=
RAILWAY_DATABASE_HOST=mysql.railway.internal
RAILWAY_DATABASE_NAME=railway
RAILWAY_DATABASE_PASSWORD=
MYSQL_PORT=3306
MYSQL_USER=root
# Public proxy, only for scripts/load_granted_sql.py from your laptop:
# MYSQL_PUBLIC_URL=mysql://USER:PASSWORD@tokaido.proxy.rlwy.net:PORT/DATABASE

# Redis (standard-plan daily worksheet limit and unsaved worksheets).
# On Railway, REDIS_URL is the private host. From a laptop, set REDIS_HOST
# to the public proxy; REDIS_USER and REDIS_PASSWORD are required there.
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

# Azure Blob Storage for downloaded worksheets (private containers).
# The app picks one from where it is running. Railway sets RAILWAY_ENVIRONMENT,
# so the deployed service uses AZURE_STORAGE_PROD_CONTAINER. Your laptop uses
# AZURE_STORAGE_DEV_CONTAINER.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_DEV_CONTAINER=devsheets
AZURE_STORAGE_PROD_CONTAINER=worksheet

# Mailtrap Email Sending HTTPS API (not SMTP, not the sandbox).
# MAIL_PASSWORD is the Bearer token from Mailtrap → Sending → API tokens.
# MAIL_DEFAULT_SENDER must be an address on a domain you verified in Mailtrap.
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Granted Reading <you@your-verified-domain.com>

# Service principal for the Azure AI Foundry client. Never commit real values.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Stripe billing (hosted Checkout, no publishable key needed).
# STRIPE_WEBHOOK is the signing secret: the one `stripe listen` prints locally,
# or the Dashboard endpoint's secret in production.
# STRIPE_PRICE_ID is written by scripts/setup_stripe_product.py.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK=
STRIPE_PRICE_ID=
# Flask server (optional)
PORT=5000
FLASK_DEBUG=true
