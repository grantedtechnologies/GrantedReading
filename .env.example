# Azure LLM (DeepSeek agent via AI Foundry)
LLM_ENDPOINT=https://your-project.cognitiveservices.azure.com/
LLM_AGENT_NAME=your-agent-name

# Azure Service Principal authentication
# Create a service principal in Azure and set these environment variables
AZURE_CLIENT_ID=your-app-registration-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# Flux image generation
FLUX_API_KEY=your-flux-api-key
FLUX_API_URL=https://api.bfl.ml
FLUX_MODEL=FLUX.2-pro

# Flask server (optional)
PORT=5000
FLASK_DEBUG=false
