# Copy to .env.test and fill in. Never commit real secrets.
# Safety: DATABASE name must contain "test"; STRIPE_SECRET_KEY must start with sk_test_.

SECRET_KEY=e2e-test-secret
APP_VERSION=e2e

# MySQL — prefer a dedicated DB whose name contains "test" (e.g. granted_test).
# Local granteddb is also allowed; e2e+*@granted.test rows are cleaned up there.
LOCAL_DATABASE_HOST=localhost
LOCAL_DATABASE_NAME=granteddb
LOCAL_DATABASE_PASSWORD=
MYSQL_USER=root
MYSQL_PORT=3306

# Redis — local only for E2E. Clear host/user/password so redis_client
# does not prefer a cloud REDIS_HOST from a leftover shell/.env.
REDIS_URL=redis://localhost:6379/15
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=
REDIS_USERNAME=
REDIS_PASSWORD=

# Email → Mailpit
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_DEFAULT_SENDER=Granted Reading <noreply@granted.test>
MAILPIT_API=http://localhost:8025

# Mock AI (fast tier). Refuse to start if Railway/production env is set.
MOCK_AI=true
RUNPOD_WEBHOOK_SECRET=e2e-runpod-webhook-secret
PUBLIC_BASE_URL=http://127.0.0.1:5001
E2E_BASE_URL=http://127.0.0.1:5001

# Stripe test mode only
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me
# Optional; app uses hosted Checkout (no publishable key required)
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Azure Blob sandbox / Azurite
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=

# Live tier only (leave blank for fast MOCK_AI runs)
LLM_ENDPOINT=
LLM_AGENT_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
RUNPOD_API_KEY=
runpod-api-key=
ngrok-endpoint=
OLLAMA_URL=http://127.0.0.1:11434
JUDGE_MODEL=llama3.2

# Playwright / app server
BASE_URL=
E2E_PORT=5001
